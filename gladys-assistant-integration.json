{
  "manifest_version": 1,
  "type": "device",
  "name": "Wekan",
  "description": {
    "en": "Wekan kanban boards: cards due today, overdue and done, new cards, cards added from a scene.",
    "fr": "Tableaux kanban Wekan : cartes du jour, en retard et terminées, nouvelles cartes, ajout par scène.",
    "de": "Wekan-Kanban-Boards: heute fällige, überfällige und erledigte Karten, neue Karten, aus Szenen.",
    "es": "Tableros kanban de Wekan: tarjetas de hoy, atrasadas y terminadas, nuevas, añadidas por escena."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-wekan:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-wekan/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Wekan",
        "fr": "Votre Wekan",
        "de": "Dein Wekan",
        "es": "Su Wekan"
      },
      "description": {
        "en": "A self-hosted Wekan with its REST API on (WITH_API=true, the default). Give the username and password of a Wekan user with a password account (not LDAP nor OAuth).",
        "fr": "Un Wekan auto-hébergé avec son API REST active (WITH_API=true, par défaut). Donnez l'identifiant et le mot de passe d'un utilisateur de Wekan à compte par mot de passe (ni LDAP ni OAuth).",
        "de": "Ein selbst gehostetes Wekan mit aktiver REST-API (WITH_API=true, Standard). Gib Benutzername und Passwort eines Wekan-Benutzers mit Passwortkonto an (weder LDAP noch OAuth).",
        "es": "Un Wekan autoalojado con su API REST activa (WITH_API=true, por defecto). Indique el usuario y la contraseña de un usuario de Wekan con cuenta por contraseña (ni LDAP ni OAuth)."
      },
      "links": [
        {
          "url": "https://github.com/wekan/wekan/wiki/REST-API",
          "label": {
            "en": "Wekan REST API",
            "fr": "API REST de Wekan",
            "de": "Wekan-REST-API",
            "es": "API REST de Wekan"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "de": "Adresse",
        "es": "Dirección"
      },
      "description": {
        "en": "Address of Wekan, as in the browser, with https:// for HTTPS and :port if not the default.",
        "fr": "Adresse de Wekan, comme dans le navigateur, avec https:// pour le HTTPS et :port s'il n'est pas celui par défaut.",
        "de": "Adresse von Wekan wie im Browser, mit https:// für HTTPS und :Port, falls nicht der Standard.",
        "es": "Dirección de Wekan, como en el navegador, con https:// para HTTPS y :puerto si no es el predeterminado."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.20:8080",
        "fr": "ex. http://192.168.1.20:8080",
        "de": "z. B. http://192.168.1.20:8080",
        "es": "p. ej. http://192.168.1.20:8080"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Username or e-mail",
        "fr": "Identifiant ou e-mail",
        "de": "Benutzername oder E-Mail",
        "es": "Usuario o correo electrónico"
      },
      "description": {
        "en": "A Wekan user who is a member of the boards to follow. Cards added from Gladys are created in their name.",
        "fr": "Un utilisateur de Wekan membre des tableaux à suivre. Les cartes ajoutées depuis Gladys sont créées à son nom.",
        "de": "Ein Wekan-Benutzer, der Mitglied der zu verfolgenden Boards ist. Aus Gladys hinzugefügte Karten werden in seinem Namen erstellt.",
        "es": "Un usuario de Wekan miembro de los tableros que se siguen. Las tarjetas añadidas desde Gladys se crean a su nombre."
      },
      "required": true,
      "default": ""
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "required": true
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "boards",
      "type": "string",
      "label": {
        "en": "Followed boards",
        "fr": "Tableaux suivis",
        "de": "Verfolgte Boards",
        "es": "Tableros seguidos"
      },
      "description": {
        "en": "Names or ids separated by commas. Empty: every board of the user (20 at most). One device per followed board.",
        "fr": "Noms ou identifiants séparés par des virgules. Vide : tous les tableaux de l'utilisateur (20 au plus). Un appareil par tableau suivi.",
        "de": "Namen oder IDs durch Kommas getrennt. Leer: alle Boards des Benutzers (höchstens 20). Ein Gerät pro verfolgtem Board.",
        "es": "Nombres o identificadores separados por comas. Vacío: todos los tableros del usuario (20 como máximo). Un dispositivo por tablero seguido."
      },
      "placeholder": {
        "en": "e.g. Home, Shopping",
        "fr": "ex. Maison, Courses",
        "de": "z. B. Haushalt, Einkauf",
        "es": "p. ej. Casa, Compras"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "done_lists",
      "type": "string",
      "label": {
        "en": "\"Done\" lists",
        "fr": "Listes « terminé »",
        "de": "„Erledigt“-Listen",
        "es": "Listas «terminado»"
      },
      "description": {
        "en": "Lists whose cards count as done, by name, separated by commas. A card with an end date is done too.",
        "fr": "Listes dont les cartes comptent comme terminées, par nom, séparées par des virgules. Une carte avec une date de fin l'est aussi.",
        "de": "Listen, deren Karten als erledigt zählen, nach Namen, durch Kommas getrennt. Eine Karte mit Enddatum ist auch erledigt.",
        "es": "Listas cuyas tarjetas cuentan como terminadas, por nombre, separadas por comas. Una tarjeta con fecha de fin también lo está."
      },
      "required": false,
      "default": "Done, Fait, Terminé, Erledigt, Hecho"
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept self-signed certificates",
        "fr": "Accepter les certificats auto-signés",
        "de": "Selbstsignierte Zertifikate akzeptieren",
        "es": "Aceptar certificados autofirmados"
      },
      "description": {
        "en": "For an https:// address whose certificate is self-signed. Tick only for your own server.",
        "fr": "Pour une adresse en https:// dont le certificat est auto-signé. À cocher seulement pour votre propre serveur.",
        "de": "Für eine https://-Adresse mit selbstsigniertem Zertifikat. Nur für deinen eigenen Server aktivieren.",
        "es": "Para una dirección https:// con certificado autofirmado. Márquelo solo para su propio servidor."
      },
      "required": false,
      "default": false
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Wekan is read (two requests per board and one per swimlane). Due dates and midnight are always followed on time.",
        "fr": "Fréquence de lecture de Wekan (deux requêtes par tableau et une par couloir). Les échéances et minuit sont toujours suivis à l'heure.",
        "de": "Wie oft Wekan gelesen wird (zwei Anfragen pro Board und eine pro Swimlane). Fälligkeiten und Mitternacht werden immer pünktlich verfolgt.",
        "es": "Frecuencia de lectura de Wekan (dos solicitudes por tablero y una por carril). Los vencimientos y la medianoche se siguen siempre a tiempo."
      },
      "required": false,
      "default": "300",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "600",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Names given to the features when a device is added, and texts sent to scenes.",
        "fr": "Noms donnés aux fonctionnalités à l'ajout d'un appareil, et textes envoyés aux scènes.",
        "de": "Namen der Funktionen beim Hinzufügen eines Geräts und an Szenen gesendete Texte.",
        "es": "Nombres dados a las funciones al añadir un dispositivo y textos enviados a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads Wekan now and reports what it finds.",
        "fr": "Lit Wekan maintenant et indique ce qu'elle trouve.",
        "de": "Liest Wekan jetzt und meldet, was gefunden wurde.",
        "es": "Lee Wekan ahora e informa de lo que encuentra."
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "card_added",
      "label": {
        "en": "New Wekan card",
        "fr": "Nouvelle carte Wekan",
        "de": "Neue Wekan-Karte",
        "es": "Nueva tarjeta de Wekan"
      },
      "description": {
        "en": "A card appeared on a followed board (created, restored or brought from another board).",
        "fr": "Une carte est apparue sur un tableau suivi (créée, restaurée ou venue d'un autre tableau).",
        "de": "Eine Karte ist auf einem verfolgten Board erschienen (erstellt, wiederhergestellt oder von einem anderen Board).",
        "es": "Apareció una tarjeta en un tablero seguido (creada, restaurada o traída de otro tablero)."
      },
      "fields": [
        {
          "key": "board",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Board (empty: any)",
            "fr": "Tableau (vide : tous)",
            "de": "Board (leer: alle)",
            "es": "Tablero (vacío: cualquiera)"
          }
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "List name (empty: any)",
            "fr": "Nom de la liste (vide : toutes)",
            "de": "Listenname (leer: alle)",
            "es": "Nombre de la lista (vacío: cualquiera)"
          },
          "description": {
            "en": "Exactly as written in Wekan, e.g. Done.",
            "fr": "Exactement comme dans Wekan, ex. Fait.",
            "de": "Genau wie in Wekan, z. B. Erledigt.",
            "es": "Exactamente como en Wekan, p. ej. Hecho."
          }
        }
      ],
      "variables": [
        {
          "key": "card",
          "type": "string",
          "label": {
            "en": "Card",
            "fr": "Carte",
            "de": "Karte",
            "es": "Tarjeta"
          }
        },
        {
          "key": "card_id",
          "type": "string",
          "label": {
            "en": "Card id",
            "fr": "Identifiant de la carte",
            "de": "Karten-ID",
            "es": "Identificador de la tarjeta"
          }
        },
        {
          "key": "board_name",
          "type": "string",
          "label": {
            "en": "Board",
            "fr": "Tableau",
            "de": "Board",
            "es": "Tablero"
          }
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "List",
