  "scene_actions": [
    {
      "key": "add_card",
      "label": {
        "en": "Add a Wekan card",
        "fr": "Ajouter une carte Wekan",
        "de": "Wekan-Karte hinzufügen",
        "es": "Añadir una tarjeta de Wekan"
      },
      "description": {
        "en": "Adds a card to a list, in the first swimlane, as the configured user.",
        "fr": "Ajoute une carte dans une liste, dans le premier couloir, au nom de l'utilisateur configuré.",
        "de": "Fügt eine Karte in eine Liste ein, in die erste Swimlane, als konfigurierter Benutzer.",
        "es": "Añade una tarjeta a una lista, en el primer carril, como el usuario configurado."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "title",
          "type": "string",
          "required": true,
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel",
            "es": "Título"
          }
        },
        {
          "key": "board",
          "type": "string",
          "label": {
            "en": "Board name (empty: the first one)",
            "fr": "Nom du tableau (vide : le premier)",
            "de": "Board-Name (leer: das erste)",
            "es": "Nombre del tablero (vacío: el primero)"
          }
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "List name (empty: the first one)",
